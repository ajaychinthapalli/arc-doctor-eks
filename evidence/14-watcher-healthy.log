# In-cluster watcher CronJob, triggered by hand on a healthy cluster (2026-10-08 ~20:58 MST)
# Flows 5-6: reads ARC state, finds nothing stuck, does not call the agent.
bash-5.3$ kubectl -n arc-systems create job arc-watch-now --from=cronjob/arc-watcher
job.batch/arc-watch-now created
bash-5.3$ sleep 20; kubectl -n arc-systems logs job/arc-watch-now
[2026-10-09T03:58:39Z] All ARC scale sets healthy.
bash-5.3$
